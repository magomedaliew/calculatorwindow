<Application
    x:Class="calculatorwindow.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:calculatorwindow">
 <Application.Resources>
  <!--Button-->
  <Style TargetType="Button">
   <Setter Property="VerticalAlignment" Value="3"/>
   <Setter Property="HorizontalAlignment" Value="3"/>
   <Setter Property="VerticalContentAlignment" Value="1"/>
   <Setter Property="HorizontalContentAlignment" Value="1"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="3"/>
  </Style>
  <!--TextBlock-->
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="FontFamily" Value="Consolas"/>

   <!--<Setter Property="IsTextSelectionEnabled" Value="True"/>-->
   <!--<Setter Property="SelectionHighlightColor" Value="SkyBlue"/>-->
  </Style>
 </Application.Resources>
</Application>
